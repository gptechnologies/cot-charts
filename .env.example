# Environment variables for COT Non-Commercials Dashboard

# Data URL - CSV file containing COT data
# If not set, defaults to the GitHub CSV URL
NEXT_PUBLIC_DATA_URL=https://raw.githubusercontent.com/gptechnologies/COTData/refs/heads/main/cot.csv

# Daily policy-rate CSV. If not set, defaults to the COTData GitHub URL.
NEXT_PUBLIC_POLICY_RATES_URL=https://raw.githubusercontent.com/gptechnologies/COTData/refs/heads/main/policy_rates.csv
